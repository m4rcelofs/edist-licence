<?xml version="1.0" encoding="utf-8"?>
<web-app xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns="http://java.sun.com/xml/ns/javaee" xmlns:web="http://java.sun.com/xml/ns/javaee/web-app_2_5.xsd"
	xsi:schemaLocation="http://java.sun.com/xml/ns/javaee
http://java.sun.com/xml/ns/javaee/web-app_2_5.xsd"
	version="2.5">



	<!-- external facade -->
	<servlet>
		<servlet-name>getLicence</servlet-name>
		<servlet-class>com.erep.dist.licence.GetLicenceServlet</servlet-class>
	</servlet>
	<servlet-mapping>
		<servlet-name>getLicence</servlet-name>
		<url-pattern>/getlicence</url-pattern>
	</servlet-mapping>

	<servlet>
		<servlet-name>updateEmail</servlet-name>
		<servlet-class>com.erep.dist.licence.UpdateEmailServlet</servlet-class>
	</servlet>
	<servlet-mapping>
		<servlet-name>updateEmail</servlet-name>
		<url-pattern>/updateEmail</url-pattern>
	</servlet-mapping>

	<!-- cron -->

	<servlet>
		<servlet-name>notifyLicenceExpiring</servlet-name>
		<servlet-class>com.erep.dist.licence.EmailNotificationJob</servlet-class>
	</servlet>
	<servlet-mapping>
		<servlet-name>notifyLicenceExpiring</servlet-name>
		<url-pattern>/admin/cron/notifyLicence</url-pattern>
	</servlet-mapping>

	<!-- private dwr -->
	<servlet>
		<display-name>DWR Management Servlet</display-name>
		<servlet-name>dwr-management-invoker</servlet-name>
		<servlet-class>org.directwebremoting.servlet.DwrServlet</servlet-class>
		<init-param>
			<param-name>classes</param-name>
			<param-value>
				com.erep.dist.licence.dwr.ManagementService,
				com.erep.dist.licence.data.Licence,
				com.erep.dist.licence.dwr.LicencesQuery,
				com.erep.dist.licence.data.Payment,
				com.erep.dist.licence.data.PaymentType
    		</param-value>
		</init-param>
	</servlet>

	<servlet-mapping>
		<servlet-name>dwr-management-invoker</servlet-name>
		<url-pattern>/admin/dwr/*</url-pattern>
	</servlet-mapping>

	<!-- pages -->
	<servlet>
		<servlet-name>adminPage</servlet-name>
		<jsp-file>/admin/index.jsp</jsp-file>
	</servlet>

	<servlet-mapping>
		<servlet-name>adminPage</servlet-name>
		<url-pattern>/admin/*</url-pattern>
	</servlet-mapping>
	
	<servlet>
		<servlet-name>changelogPage</servlet-name>
		<jsp-file>/changelog.jsp</jsp-file>
	</servlet>

	<servlet-mapping>
		<servlet-name>changelogPage</servlet-name>
		<url-pattern>/changelog/*</url-pattern>
	</servlet-mapping>

	<servlet>
		<servlet-name>pricesPage</servlet-name>
		<jsp-file>/prices.jsp</jsp-file>
	</servlet>

	<servlet-mapping>
		<servlet-name>pricesPage</servlet-name>
		<url-pattern>/prices/*</url-pattern>
	</servlet-mapping>

	<servlet>
		<servlet-name>termsPage</servlet-name>
		<jsp-file>/terms.jsp</jsp-file>
	</servlet>

	<servlet-mapping>
		<servlet-name>termsPage</servlet-name>
		<url-pattern>/terms/*</url-pattern>
	</servlet-mapping>

	<servlet>
		<servlet-name>indexPage</servlet-name>
		<jsp-file>/index.jsp</jsp-file>
	</servlet>

	<servlet-mapping>
		<servlet-name>indexPage</servlet-name>
		<url-pattern>/*</url-pattern>
	</servlet-mapping>

	<!-- default file -->
	<welcome-file-list>
		<welcome-file>index.jsp</welcome-file>
	</welcome-file-list>

	<!-- security -->
	<security-constraint>
		<web-resource-collection>
			<url-pattern>/admin/*</url-pattern>
		</web-resource-collection>
		<auth-constraint>
			<role-name>admin</role-name>
		</auth-constraint>
		<user-data-constraint>
			<transport-guarantee>CONFIDENTIAL</transport-guarantee>
		</user-data-constraint>
	</security-constraint>

</web-app>
